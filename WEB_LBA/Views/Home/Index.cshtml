@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/Index.css?v=5" />

<div class="page-bg" aria-hidden="true"></div>

<div class="landing-wrap">
    <main class="hero glass" role="main" aria-label="Accesos y bienvenida">
        <h1>Bienvenidos</h1>
        <p class="subtitle">
            Plataforma del <b>Liceo Boca de Arenal</b>.<br />
            Elegí el tipo de acceso para continuar.
        </p>
        <div class="divider" aria-hidden="true"></div>

        <!-- Accesos -->
        <div class="login-grid" role="list">
            <a role="listitem"
               class="login-card"
               href="@Url.Action("LoginAdministrativo", "Usuario")"
               aria-label="Ingresar: Login Administrativo">
                <img loading="lazy"
                     src="@Url.Content("~/Content/imagenesWeb/admin.jpg")"
                     alt="Ícono acceso administrativo">
                <h5>Login Administrativo</h5>
            </a>

            <a role="listitem"
               class="login-card"
               href="@Url.Action("LoginEstudiante", "Usuario")"
               aria-label="Ingresar: Login Estudiantes">
                <img loading="lazy"
                     src="@Url.Content("~/Content/imagenesWeb/logest.jpg")"
                     alt="Ícono acceso estudiantes">
                <h5>Login Estudiantes</h5>
            </a>
        </div>

        <!-- Información institucional -->
        <section class="info glass" aria-label="Información institucional">
            <h4>Acerca del Liceo Boca de Arenal</h4>
            <p>
                Somos una institución pública comprometida con la formación académica y humana de nuestros estudiantes.
                Creemos en el respeto, la inclusión y la excelencia.
            </p>

            <ul class="info-list">
                <li class="info-item"><b>Dirección:</b><br>Boca de Arenal, San Carlos</li>
                <li class="info-item"><b>Teléfono:</b><br>8480 0101</li>
                <li class="info-item">
                    <b>Correo:</b><br>
                    <a href="mailto:liceoba03@gmail.com">liceoba03@gmail.com</a>
                </li>
            </ul>

            <p class="help-line">
                📩 ¿Problemas de acceso? Escribí a <em>liceoba03@gmail.com</em>
            </p>
        </section>
    </main>
</div>


