@model WEB_LBA.Models.M_Ciclo

@{
    ViewBag.Title = "Agregar Ciclo";
}

<div class="container mt-4">
    <h2>@ViewBag.Title</h2>

    @using (Html.BeginForm("Acciones", "Ciclo", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmCiclos" }))
    {
        @Html.AntiForgeryToken()

        <div class="row g-3 align-items-start">
            <div class="col-md-6">
                @Html.LabelFor(m => m.id_ciclo, new { @class = "form-label" })
                @Html.EditorFor(m => m.id_ciclo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.id_ciclo, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                @Html.LabelFor(m => m.nombre_ciclo, new { @class = "form-label" })
                @Html.EditorFor(m => m.nombre_ciclo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.nombre_ciclo, "", new { @class = "text-danger" })
            </div>

            <div class="col-12">
                @Html.LabelFor(m => m.descripcion, new { @class = "form-label" })
                @Html.EditorFor(m => m.descripcion, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.descripcion, "", new { @class = "text-danger" })
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary" name="submitButton" value="Agregar">Agregar</button>
                @Html.ActionLink("Volver a Ciclos", "ListCiclos", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
