@model IEnumerable<WEB_LBA.Models.M_Ciclo>

@{
    ViewBag.Title = "Ciclos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Content/Ciclos.css" rel="stylesheet" />
}

<div class="contenedor-lista">
    <div class="encabezado">
        <h2>Lista de Ciclos</h2>
        @Html.ActionLink("➕ Crear Ciclo", "AgregarCiclos", null, new { @class = "btn btn-success btn-crear" })
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-header">
            <tr>
                <th>ID Ciclo</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.id_ciclo</td>
                    <td>@item.nombre_ciclo</td>
                    <td>@item.descripcion</td>
                    <td>
                        @Html.ActionLink("✏️ Modificar", "ModificaCiclos", new { id = item.id_ciclo }, new { @class = "btn btn-warning btn-sm me-1" })
                        @Html.ActionLink("🗑️ Eliminar", "EliminaCiclos", new { id = item.id_ciclo }, new { @class = "btn btn-danger btn-sm me-1" })
                        @Html.ActionLink("📘 Ver Secciones", "VerSeccionesPorCiclo", "Seccion", new { id = item.id_ciclo }, new { @class = "btn btn-info btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>