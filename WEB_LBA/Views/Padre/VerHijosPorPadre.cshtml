@model List<WEB_LBA.Models.M_EstudianteConsulta>
@{
    ViewBag.Title = "Hijos del Padre";
    int idPadre = ViewBag.IdPadre;
}

<h2>Hijos Asignados</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Número de Cédula (Con ceros)</th>
            <th>Nombre del Estudiante (Con Apellidos)</th>
            <th>Dirección</th>
            <th>Número de teléfono</th>
            <th>Sección</th>
            <th>Acción</th> <!-- Columna para botón Quitar -->
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var estudiante in Model)
            {
                <tr>
                    <td>@estudiante.cedula</td>
                    <td>@estudiante.nombre</td>
                    <td>@estudiante.direccion</td>
                    <td>@estudiante.telefono</td>
                    <td>@estudiante.seccion</td>
                    <td>
                        @Html.ActionLink(
                            "Quitar",
                            "QuitarHijo",
                            "Padre",
                            new { idPadre = idPadre, idEstudiante = estudiante.id_estudiante },
                            new { @class = "btn btn-danger btn-sm", onclick = "return confirm('¿Está seguro que desea quitar este hijo?');" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-warning">Este padre no tiene hijos asignados.</td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("ListPadres", "Padre")" class="btn btn-secondary">Volver a la lista de Padres</a>
