@model List<WEB_LBA.Models.M_EstudianteConsulta>
@{
    ViewBag.Title = "Asignar Hijos";
    int idPadre = ViewBag.IdPadre;
    string filtroCedula = Request["filtroCedula"] ?? "";
}

<style>
    .contenedor-asignar {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        max-width: 1000px;
        margin: 30px auto;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
    }

    .titulo {
        text-align: center;
        color: #0d47a1;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .form-inline label {
        font-weight: 600;
        margin-right: 10px;
    }

    .tabla-responsive {
        overflow-x: auto;
    }

    .table th {
        background-color: #0d47a1;
        color: white;
    }
</style>

<div class="contenedor-asignar">
    <h2 class="titulo">Asignar Hijos</h2>

    <!-- Formulario de búsqueda -->
    @using (Html.BeginForm("AsignarHijos", "Padre", FormMethod.Get))
    {
        <input type="hidden" name="idPadre" value="@idPadre" />

        <div class="mb-3 row">
            <div class="col-md-9">
                <label for="filtroCedula" class="form-label">Buscar por Cédula:</label>
                <input type="text" name="filtroCedula" value="@filtroCedula" class="form-control" placeholder="Ingrese cédula del estudiante" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
        </div>
    }

    <div class="tabla-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Sección</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    var estudiantesFiltrados = string.IsNullOrEmpty(filtroCedula)
                        ? Model
                        : Model.Where(e => e.cedula.Contains(filtroCedula)).ToList();

                    if (estudiantesFiltrados.Any())
                    {
                        foreach (var estudiante in estudiantesFiltrados)
                        {
                            <tr>
                                <td>@estudiante.cedula</td>
                                <td>@estudiante.nombre</td>
                                <td>@estudiante.direccion</td>
                                <td>@estudiante.telefono</td>
                                <td>@estudiante.seccion</td>
                                <td>
                                    @Html.ActionLink("Asignar", "AsignarHijo", "Padre", new { idPadre = idPadre, idEstudiante = estudiante.id_estudiante }, new { @class = "btn btn-success btn-sm" })
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-warning">No se encontraron estudiantes con esa cédula.</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-danger">No hay estudiantes disponibles para asignar.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 text-end">
        <a href="@Url.Action("ListPadres", "Padre")" class="btn btn-secondary">Volver</a>
    </div>
</div>