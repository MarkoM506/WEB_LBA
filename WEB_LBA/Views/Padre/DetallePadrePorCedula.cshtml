@model WEB_LBA.Models.M_PadreConsulta

@{
    ViewBag.Title = "Detalle del Padre";
}

<style>
    .detalle-contenedor {
        max-width: 600px;
        margin: 50px auto;
        background-color: #f8f9fa;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        padding: 30px;
    }

        .detalle-contenedor h2 {
            text-align: center;
            color: #0d47a1;
            font-weight: bold;
            margin-bottom: 25px;
        }

    .detalle-info {
        font-size: 18px;
        line-height: 1.8;
    }

    .btn-volver {
        display: flex;
        justify-content: center;
        margin-top: 25px;
    }
</style>

<div class="detalle-contenedor">
    <h2>Detalle del Padre</h2>

    <div class="detalle-info">
        <p><strong>Nombre:</strong> @Model.nombre</p>
        <p><strong>Cédula:</strong> @Model.cedula</p>
        <p><strong>Teléfono:</strong> @Model.telefono</p>
    </div>

    <div class="btn-volver">
        @Html.ActionLink("Volver a Buscar", "BuscarPorCedula", null, new { @class = "btn btn-secondary" })
    </div>
</div>