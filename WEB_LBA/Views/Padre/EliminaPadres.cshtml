@model WEB_LBA.Models.M_Padre

@{
    ViewBag.Title = "Eliminar Padre";
}

<h2>Eliminar Padre</h2>

<h4>¿Estás seguro que deseas eliminar a este padre?</h4>
<hr />

<dl class="dl-horizontal">
    <dt>Cédula</dt>
    <dd>@Model.cedula</dd>
    <dt>Nombre</dt>
    <dd>@Model.nombre</dd>
    <dt>Teléfono</dt>
    <dd>@Model.telefono</dd>
</dl>

@using (Html.BeginForm("Acciones", "Padre", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.id_padre)

    <button type="submit" name="submitButton" value="Eliminar" class="btn btn-danger">Eliminar</button>
    @Html.ActionLink("Cancelar", "ListPadres", null, new { @class = "btn btn-default" })
}
