@model WEB_LBA.Models.M_Materia

@{
    ViewBag.Title = "Modificar Materia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f1f5fb;
    }

    .contenedor-formulario {
        max-width: 700px;
        margin: 40px auto;
        background-color: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    h2.titulo {
        text-align: center;
        margin-bottom: 25px;
        color: #0d47a1;
        font-weight: bold;
    }

    .form-label {
        font-weight: 500;
    }

    .botones-acciones {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }
</style>

<div class="contenedor-formulario">
    <h2 class="titulo">Modificar Materia</h2>

    @using (Html.BeginForm("Acciones", "Materia", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.id_materia)

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.nombre_materia, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.nombre_materia, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.nombre_materia, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.Label("Profesores Asignados", new { @class = "form-label" })
            @Html.ListBoxFor(m => m.profesores_seleccionados, (MultiSelectList)ViewBag.Profesores, new { @class = "form-control", size = 6 })
            @Html.ValidationMessageFor(m => m.profesores_seleccionados, "", new { @class = "text-danger" })
        </div>

        <div class="botones-acciones">
            <input type="submit" name="submitButton" value="Actualizar" class="btn btn-warning" />
            @Html.ActionLink("Volver", "ListMaterias", null, new { @class = "btn btn-secondary" })
        </div>
    }
</div>