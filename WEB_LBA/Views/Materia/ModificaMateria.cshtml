@model WEB_LBA.Models.M_Materia
@{
    ViewBag.Title = "Modificar Materia";
}

<h2>Modificar Materia</h2>

@using (Html.BeginForm("Acciones", "Materia", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.id_materia)

    <div class="form-group">
        @Html.LabelFor(m => m.nombre_materia)
        @Html.TextBoxFor(m => m.nombre_materia, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.nombre_materia, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.Label("Profesores Asignados")
        @Html.ListBoxFor(m => m.profesores_seleccionados, (MultiSelectList)ViewBag.Profesores, new { @class = "form-control", size = 6 })
        @Html.ValidationMessageFor(m => m.profesores_seleccionados, "", new { @class = "text-danger" })
    </div>

    <input type="submit" name="submitButton" value="Actualizar" class="btn btn-warning" />
    @Html.ActionLink("Cancelar", "ListMaterias", null, new { @class = "btn btn-secondary" })
}
