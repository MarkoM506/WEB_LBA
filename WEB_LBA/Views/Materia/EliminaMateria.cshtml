@model WEB_LBA.Models.M_Materia
@{
    ViewBag.Title = "Eliminar Materia";
}

<h2>¿Está seguro que desea eliminar esta materia?</h2>

<dl class="dl-horizontal">
    <dt>ID Materia:</dt>
    <dd>@Model.id_materia</dd>

    <dt>Nombre:</dt>
    <dd>@Model.nombre_materia</dd>
</dl>

@using (Html.BeginForm("Acciones", "Materia", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.id_materia)
    @Html.HiddenFor(m => m.nombre_materia)

    <input type="submit" name="submitButton" value="Eliminar" class="btn btn-danger" />
    @Html.ActionLink("Cancelar", "ListMaterias", null, new { @class = "btn btn-secondary" })
}
