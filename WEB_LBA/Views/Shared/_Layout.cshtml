<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - LICEO BOCA DE ARENAL</title>

    @Styles.Render("~/Content/css")
    <!-- Bootstrap 5.3 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("LBA", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Acerca de", "About", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Contacto", "Contact", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Ciclos", "ListCiclos", "Ciclo", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Secciones", "ListSecciones", "Seccion", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Estudiantes", "ListEstudiantes", "Estudiante", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Profesores", "ListProfesores", "Profesor", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Materias", "ListMaterias", "Materia", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Padres", "ListPadres", "Padre", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">
                        @Html.ActionLink("Consultar Asistencias", "ReporteMensual", "Asistencia", new { id_seccion = 0 }, htmlAttributes: new { @class = "nav-link" })
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content mt-4">
        @RenderBody()
        <hr />
        <footer class="text-center">
            <p>&copy; @DateTime.Now.Year - TODOS LOS DERECHOS RESERVADOS LBA.COM</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")  <!-- Aquí el script para validar -->
    @Scripts.Render("~/bundles/bootstrap")
    <!-- Bootstrap 5.3 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
