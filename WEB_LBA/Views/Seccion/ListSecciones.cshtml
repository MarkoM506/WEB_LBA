@model IEnumerable<WEB_LBA.Models.M_Seccion>

@{
    ViewBag.Title = "Secciones";
}

<h2>Lista de Secciones</h2>

<p>
    @Html.ActionLink("Crear Sección", "AgregarSecciones", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID Sección</th>
            <th>Nombre</th>
            <th>ID Ciclo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id_seccion</td>
                <td>@item.nombre_seccion</td>
                <td>@item.id_ciclo</td>
                <td>
                    @Html.ActionLink("Modificar", "ModificaSecciones", new { id = item.id_seccion }, new { @class = "btn btn-warning btn-sm me-1" })
                    @Html.ActionLink("Eliminar", "EliminaSecciones", new { id = item.id_seccion }, new { @class = "btn btn-danger btn-sm me-1" })
                    @Html.ActionLink("Ver Estudiantes", "VerEstudiantesPorSeccion", "Estudiante", new { id = item.id_seccion }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Tomar Asistencia", "SeleccionarPeriodoAsistencia", "Asistencia", new { id_seccion = item.id_seccion }, new { @class = "btn btn-success" })
                </td>
            </tr>
        }
    </tbody>
</table>