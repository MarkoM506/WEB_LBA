@model WEB_LBA.Models.M_EstudianteConsulta

@{
    ViewBag.Title = "Detalle Estudiante";

    var cedula = Model.cedula;
    var rutaFoto = $"~/ftEst/{cedula}.jpg";
    var rutaPorDefecto = "~/ftEst/default.jpg";
    var pathFisico = Server.MapPath(rutaFoto);
    var existeFoto = System.IO.File.Exists(pathFisico);
    var rutaFinal = Url.Content(existeFoto ? rutaFoto : rutaPorDefecto);
}

<h2 class="text-center">Detalle del Estudiante</h2>

<div class="card mx-auto" style="max-width: 600px;">
    <div class="card-body text-center">

        <img src="@rutaFinal" alt="Foto del estudiante"
             class="img-thumbnail mb-3"
             style="max-width: 200px;" />

        <h5 class="card-title">@Model.nombre</h5>

        <p class="card-text"><strong>Cédula:</strong> @Model.cedula</p>
        <p class="card-text"><strong>Dirección:</strong> @Model.direccion</p>
        <p class="card-text"><strong>Teléfono:</strong> @Model.telefono</p>
        <p class="card-text"><strong>Sección:</strong> @Model.seccion</p>

        <div class="d-flex justify-content-center mt-3">
            @Html.ActionLink("Volver a Buscar", "BuscarPorCedula", null, new { @class = "btn btn-secondary me-2" })
            @Html.ActionLink("Volver a Estudiantes", "ListEstudiantes", null, new { @class = "btn btn-primary" })
        </div>
    </div>
</div>
