@model List<WEB_LBA.Models.M_Estudiante>

@{
    ViewBag.Title = "Estudiantes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Content/Estudiantes.css" rel="stylesheet" />
}

<div class="contenedor-lista">
    <div class="encabezado">
        <h2>Lista de Estudiantes</h2>
        <div>
            @Html.ActionLink("👦 Agregar Estudiante", "AgregarEstudiantes", null, new { @class = "btn btn-success btn-crear me-2" })
            @Html.ActionLink("🔎 Buscar por Cédula", "BuscarPorCedula", null, new { @class = "btn btn-info btn-crear" })
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-header">
            <tr>
                <th>🆔 Cédula</th>
                <th>📛 Nombre</th>
                <th>📍 Dirección</th>
                <th>📞 Teléfono</th>
                <th>🏫 Sección</th>
                <th>⚙️ Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.cedula</td>
                    <td>@item.nombre</td>
                    <td>@item.direccion</td>
                    <td>@item.telefono</td>
                    <td>@item.id_seccion</td>
                    <td>
                        @Html.ActionLink("✏️ Modificar", "ModificaEstudiantes", new { id = item.id_estudiante }, new { @class = "btn btn-warning btn-sm me-1" })
                        @Html.ActionLink("🗑️ Eliminar", "EliminaEstudiantes", new { id = item.id_estudiante }, new { @class = "btn btn-danger btn-sm me-1" })
                        @Html.ActionLink("👪 Ver Padres", "VerPadresPorEstudiante", new { id = item.id_estudiante }, new { @class = "btn btn-info btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>