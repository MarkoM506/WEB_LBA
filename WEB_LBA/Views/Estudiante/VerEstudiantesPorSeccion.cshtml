@model List<WEB_LBA.Models.M_EstudianteConsulta>

@{
    ViewBag.Title = "Estudiantes por Sección";
}

<h2>Estudiantes por Sección</h2>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Dirección</th>
            <th>Teléfono</th>
            <th>Sección</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.cedula</td>
                <td>@item.nombre</td>
                <td>@item.direccion</td>
                <td>@item.telefono</td>
                <td>@item.seccion</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @Html.ActionLink("Volver a Secciones", "ListSecciones", "Seccion", null, new { @class = "btn btn-secondary" })
</div>
