@model List<Entidades.SP_recNoticias_Result>
@{
    ViewBag.Title = "Gestión de Noticias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        body {
            background-image: url('@Url.Content("~/Content/imagenesWeb/bgg.png")');
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Arial', sans-serif;
        }

        /* Contenedor principal */
        .panel-container {
            background-color: rgba(255, 255, 255, 0.95);
            padding: 40px;
            border-radius: 15px;
            max-width: 1100px;
            margin: 50px auto;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

        /* Título de la página */
        .panel-container h2 {
            font-size: 32px;
            font-weight: 700;
            color: #333;
            margin-bottom: 30px;
        }

        /* Tarjeta de noticia */
        .noticia-card {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 25px;
            background-color: #fff;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
            transition: box-shadow 0.3s ease-in-out;
        }

        .noticia-card:hover {
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        .noticia-card img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .noticia-card h4 {
            font-weight: bold;
            color: #0d47a1;
            font-size: 24px;
            margin-bottom: 15px;
        }

        .noticia-card p {
            font-size: 16px;
            color: #555;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        .noticia-card .fecha-publicacion {
            font-size: 14px;
            color: #777;
        }

        /* Botones */
        .btn-accion {
            margin-right: 10px;
        }

        .btn {
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

        .btn-danger {
            background-color: #dc3545;
            color: white;
        }

        .btn-danger:hover {
            background-color: #c82333;
        }

        .btn-primary {
            background-color: #007bff;
            color: white;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

        .btn-success {
            background-color: #28a745;
            color: white;
        }

        .btn-success:hover {
            background-color: #218838;
        }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

        /* Espaciado y botones */
        .volver-panel {
            margin-top: 30px;
        }

        /* Botón de agregar noticia */
        .text-center a {
            padding: 12px 25px;
            font-size: 18px;
            border-radius: 8px;
            margin: 15px 0;
            transition: background-color 0.3s ease;
        }

        .btn-success {
            background-color: #28a745;
        }

        .btn-success:hover {
            background-color: #218838;
        }
    </style>
}

<div class="panel-container">
    <h2 class="text-center mb-4">Gestión de Noticias</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="noticia-card">
            <img src="@Url.Content(item.imagen_url)" alt="Imagen de la noticia" />
            <h4>@item.titulo</h4>
            <p>@item.contenido</p>
            <p class="fecha-publicacion"><strong>Publicado el:</strong> @item.fecha_publicacion.ToShortDateString()</p>

            <!-- Eliminar -->
            @using (Html.BeginForm("Acciones", "Noticia", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.Hidden("id_noticia", item.id_noticia)
                <button type="submit" name="submitButton" value="Eliminar" class="btn btn-danger btn-accion">Eliminar</button>
            }

            <!-- Editar -->
            @using (Html.BeginForm("Acciones", "Noticia", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <input type="hidden" name="id_noticia" value="@item.id_noticia" />
                <div class="form-group">
                    <label>Título</label>
                    <input type="text" name="titulo" value="@item.titulo" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Contenido</label>
                    <textarea name="contenido" class="form-control">@item.contenido</textarea>
                </div>
                <div class="form-group">
                    <label>Fecha de Publicación</label>
                    <input type="date" name="fecha_publicacion" value="@item.fecha_publicacion.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Imagen nueva (opcional)</label>
                    <input type="file" name="imagen" class="form-control" />
                </div>
                <input type="hidden" name="imagen_url" value="@item.imagen_url" />
                <button type="submit" name="submitButton" value="Actualizar" class="btn btn-primary mt-2">Actualizar</button>
            }
        </div>
    }

    <!-- Botón para agregar noticia -->
    <div class="text-center mt-4">
        <a href="@Url.Action("AgregarNoticias", "Noticia")" class="btn btn-success">Agregar Noticia</a>
    </div>

    <!-- Botón para volver al panel administrativo -->
    <div class="text-center volver-panel">
        <a href="@Url.Action("PanelAdministrativo", "Home")" class="btn btn-secondary">Volver a Panel Administrativo</a>
    </div>
</div>
