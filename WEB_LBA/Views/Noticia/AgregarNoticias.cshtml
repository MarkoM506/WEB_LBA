@model WEB_LBA.Models.M_Noticia

@{
    ViewBag.Title = "Agregar Noticia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/Content/Noticias.css" rel="stylesheet" />
}

<div class="formulario-noticia">
    <h2>📰 Agregar Nueva Noticia</h2>

    @using (Html.BeginForm("Acciones", "Noticia", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(model => model.titulo)
            @Html.TextBoxFor(model => model.titulo, new { @class = "form-control", placeholder = "Título de la noticia" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.contenido)
            @Html.TextAreaFor(model => model.contenido, new { @class = "form-control", placeholder = "Contenido de la noticia", rows = 5 })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.fecha_publicacion)
            @Html.TextBoxFor(model => model.fecha_publicacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group">
            <label>Subir Imagen</label>
            <input type="file" name="imagen" class="form-control" />
        </div>

        <input type="hidden" name="imagen_url" value="@Model?.imagen_url" />

        <button type="submit" name="submitButton" value="Agregar" class="btn btn-primary">💾 Guardar Noticia</button>
        @Html.ActionLink("Volver", "ListNoticias", null, new { @class = "btn btn-secondary ms-2" })
    }
</div>