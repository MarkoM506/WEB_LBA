@model List<WEB_LBA.Models.M_Noticia>
@{
    ViewBag.Title = "Noticias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Inyecta la ruta de la imagen para el fondo -->
<style>
  :root { --bg-url: url('@Url.Content("~/Content/imagenesWeb/bgg.png")'); }
</style>

<link rel="stylesheet" href="~/Content/ListNoticias.css?v=3" />

<div class="page-bg" aria-hidden="true"></div>

<div class="landing-wrap">
    <div class="glass hero">
        <h2>Últimas Noticias</h2>
        <p class="subtitle">Mantente al día con lo más reciente de nuestro colegio.</p>
        <div class="divider"></div>
    </div>

    <div class="noticia-container">
        @foreach (var item in Model)
        {
            <article class="noticia-card glass" tabindex="0">
                <div class="noticia-media">
                    <img src="@Url.Content(item.imagen_url)"
                         alt="Imagen de la noticia: @item.titulo"
                         loading="lazy" />
                </div>
                <div class="noticia-text">
                    <h4 class="noticia-title">@item.titulo</h4>
                    <p>@item.contenido</p>
                    <p class="noticia-date"><strong>Publicado el:</strong> @item.fecha_publicacion.ToShortDateString()</p>
                </div>
            </article>
        }
    </div>
</div>
