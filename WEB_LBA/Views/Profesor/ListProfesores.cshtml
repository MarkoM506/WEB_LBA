@model IEnumerable<WEB_LBA.Models.M_Profesor>

@{
    ViewBag.Title = "Profesores";
}

<h2>Profesores</h2>

<p>
    @Html.ActionLink("Crear Profesor", "AgregarProfesores", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Ver Profesores con Materias", "ListProfesoresConMaterias", null, new { @class = "btn btn-secondary ms-2" })
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID Profesor</th>
            <th>Cédula</th>
            <th>Nombre De Profesor</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id_profesor</td>
                <td>@item.cedula</td>
                <td>@item.nombre</td>
                <td>
                    @Html.ActionLink("Modificar", "ModificaProfesores", new { id = item.id_profesor }, new { @class = "btn btn-warning btn-sm me-1" })
                    @Html.ActionLink("Eliminar", "EliminaProfesores", new { id = item.id_profesor }, new { @class = "btn btn-danger btn-sm me-1" })
                    @Html.ActionLink("Ver Materias", "VerMateriasPorProfesor", new { id = item.id_profesor }, new { @class = "btn btn-info btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
