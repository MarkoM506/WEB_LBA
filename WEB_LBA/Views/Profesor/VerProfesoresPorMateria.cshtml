@model IEnumerable<WEB_LBA.Models.M_ProfesorPorMateria>

@{
    ViewBag.Title = "Profesores por Materia";
}

<h2>Profesores por Materia</h2>

<p>
    @Html.ActionLink("Volver a Materias", "ListMaterias", null, new { @class = "btn btn-secondary" })
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID Profesor</th>
            <th>Nombre Profesor</th>
            <th>ID Materia</th>
            <th>Nombre Materia</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id_profesor</td>
                <td>@item.nombre_profesor</td>
                <td>@item.id_materia</td>
                <td>@item.nombre_materia</td>
            </tr>
        }
    </tbody>
</table>
