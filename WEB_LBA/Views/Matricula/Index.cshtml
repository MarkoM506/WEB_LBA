@model WEB_LBA.Models.M_MatriculaMEP
@{
    ViewBag.Title = "Formulario de Matrícula";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f4f6f9;
    }

    h2 {
        text-align: center;
        margin-top: 30px;
        color: #0d47a1;
        font-weight: bold;
    }

    fieldset {
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 25px;
        background-color: white;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    legend {
        font-size: 18px;
        font-weight: bold;
        color: #0d47a1;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: 500;
        color: #333;
    }

    .form-control {
        border-radius: 6px;
        padding: 8px 12px;
    }

    button {
        margin-right: 15px;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: 500;
    }

    .btn-primary {
        background-color: #0d47a1;
        border: none;
    }

    .btn-success {
        background-color: #2e7d32;
        border: none;
    }

    media (min-width: 768px) {
        fieldset {
            max-width: 700px;
            margin: auto;
        }
    }
</style>

<h2>Formulario de Matrícula - Primer Ingreso</h2>

@using (Html.BeginForm("Index", "Matricula", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <fieldset>
        <legend>Datos del Estudiante</legend>

        <div class="form-group">
            @Html.LabelFor(m => m.nombre_estudiante)
            @Html.TextBoxFor(m => m.nombre_estudiante, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.cedula_estudiante)
            @Html.TextBoxFor(m => m.cedula_estudiante, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.escuela_procedencia)
            @Html.TextBoxFor(m => m.escuela_procedencia, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.fecha_nacimiento)
            @Html.TextBoxFor(m => m.fecha_nacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.telefono_estudiante)
            @Html.TextBoxFor(m => m.telefono_estudiante, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.nivel)
            @Html.DropDownListFor(m => m.nivel, new SelectList(new[] { "Sétimo", "Octavo", "Noveno", "Décimo", "Undécimo" }), "Seleccione un nivel", new { @class = "form-control" })
        </div>
    </fieldset>

    <fieldset>
        <legend>Datos del Encargado</legend>

        <div class="form-group">
            @Html.LabelFor(m => m.nombre_padre)
            @Html.TextBoxFor(m => m.nombre_padre, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.cedula_padre)
            @Html.TextBoxFor(m => m.cedula_padre, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.telefono_padre)
            @Html.TextBoxFor(m => m.telefono_padre, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.direccion_padre)
            @Html.TextAreaFor(m => m.direccion_padre, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.parentesco)
            @Html.DropDownListFor(m => m.parentesco, new SelectList(new[] { "Padre", "Madre", "Encargado Legal" }), "Seleccione el parentesco", new { @class = "form-control" })
        </div>
    </fieldset>

    <fieldset>
        <legend>Cita de Matrícula</legend>

        <div class="form-group">
            @Html.LabelFor(m => m.fecha_cita)
            @Html.TextBoxFor(m => m.fecha_cita, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", min = DateTime.Today.ToString("yyyy-MM-dd") })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.hora_cita)
            <select name="hora_cita" class="form-control" required>
                <option value="">-- Seleccione la hora --</option>
                <option>07:00 AM</option>
                <option>07:30 AM</option>
                <option>08:00 AM</option>
                <option>08:30 AM</option>
                <option>09:00 AM</option>
                <option>09:30 AM</option>
                <option>10:00 AM</option>
                <option>10:30 AM</option>
                <option>11:00 AM</option>
                <option>11:30 AM</option>
                <option>12:00 PM</option>
                <option>12:30 PM</option>
                <option>01:00 PM</option>
                <option>01:30 PM</option>
                <option>02:00 PM</option>
                <option>02:30 PM</option>
                <option>03:00 PM</option>
                <option>03:30 PM</option>
                <option>04:00 PM</option>
                <option>04:30 PM</option>
                <option>05:00 PM</option>
            </select>
        </div>
    </fieldset>

    <br />
    <div class="text-center">
        <button type="submit" name="accion" value="GenerarPDF" class="btn btn-primary">📄 Generar PDF</button>
        <button type="submit" name="accion" value="EnviarWhatsapp" class="btn btn-success">📤 Enviar Matrícula por WhatsApp</button>
    </div>
}