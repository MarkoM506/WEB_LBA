@model WEB_LBA.Models.M_MatriculaMEP
@{
    ViewBag.Title = "Formulario de Matrícula";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/Matricula.css?v=3" />

<!-- Fondo: inyectamos la URL real de la imagen vía Razor en una CSS var -->
<div class="page-bg" style="--bg-url: url('@Url.Content("~/Content/imagenesWeb/bgg.png")');" aria-hidden="true"></div>

<main class="enroll-page" role="main" aria-label="Formulario de matrícula">
    <header class="enroll-hero glass">
        <h1 class="page-title">Formulario de Matrícula</h1>
        <p class="page-subtitle">Primer ingreso — Complete los datos y seleccione su cita.</p>
        <span class="title-accent" aria-hidden="true"></span>
    </header>

    @using (Html.BeginForm("Index", "Matricula", FormMethod.Post, new { enctype = "multipart/form-data", @class = "enroll-form glass" }))
    {
        @Html.AntiForgeryToken()

        <!-- Datos del Estudiante -->
        <fieldset class="en-section">
            <legend class="en-legend">Datos del Estudiante</legend>
            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(m => m.nombre_estudiante)
                    @Html.TextBoxFor(m => m.nombre_estudiante, new { @class = "form-control", placeholder = "Nombre completo" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.cedula_estudiante, "Cédula")
                    @Html.TextBoxFor(m => m.cedula_estudiante, new { @class = "form-control", placeholder = "Ej: 1-2345-6789" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.escuela_procedencia, "Escuela de procedencia")
                    @Html.TextBoxFor(m => m.escuela_procedencia, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.fecha_nacimiento, "Fecha de nacimiento")
                    @Html.TextBoxFor(m => m.fecha_nacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.telefono_estudiante, "Teléfono del estudiante")
                    @Html.TextBoxFor(m => m.telefono_estudiante, new { @class = "form-control", placeholder = "Ej: 8888-8888" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.nivel, "Nivel")
                    @Html.DropDownListFor(
                        m => m.nivel,
                        new SelectList(new[] { "Sétimo", "Octavo", "Noveno", "Décimo", "Undécimo" }),
                        "Seleccione un nivel",
                        new { @class = "form-control" }
                    )
                </div>
            </div>
        </fieldset>

        <!-- Datos del Encargado -->
        <fieldset class="en-section">
            <legend class="en-legend">Datos del Encargado</legend>
            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(m => m.nombre_padre, "Nombre del encargado")
                    @Html.TextBoxFor(m => m.nombre_padre, new { @class = "form-control", placeholder = "Nombre y apellidos" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.cedula_padre, "Cédula del encargado")
                    @Html.TextBoxFor(m => m.cedula_padre, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.telefono_padre, "Teléfono del encargado")
                    @Html.TextBoxFor(m => m.telefono_padre, new { @class = "form-control" })
                </div>
                <div class="form-group form-group--full">
                    @Html.LabelFor(m => m.direccion_padre, "Dirección")
                    @Html.TextAreaFor(m => m.direccion_padre, new { @class = "form-control", rows = 3 })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.parentesco)
                    @Html.DropDownListFor(
                        m => m.parentesco,
                        new SelectList(new[] { "Padre", "Madre", "Encargado Legal" }),
                        "Seleccione el parentesco",
                        new { @class = "form-control" }
                    )
                </div>
            </div>
        </fieldset>

        <!-- Cita de Matrícula -->
        <fieldset class="en-section">
            <legend class="en-legend">Cita de Matrícula</legend>
            <div class="form-grid">
                <div class="form-group">
                    @Html.LabelFor(m => m.fecha_cita, "Fecha de la cita")
                    @Html.TextBoxFor(
                        m => m.fecha_cita,
                        "{0:yyyy-MM-dd}",
                        new { @class = "form-control", type = "date", min = DateTime.Today.ToString("yyyy-MM-dd") }
                    )
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.hora_cita, "Hora de la cita")
                    <select name="hora_cita" class="form-control" required>
                        <option value="">-- Seleccione la hora --</option>
                        <option>07:00 AM</option>
                        <option>07:30 AM</option>
                        <option>08:00 AM</option>
                        <option>08:30 AM</option>
                        <option>09:00 AM</option>
                        <option>09:30 AM</option>
                        <option>10:00 AM</option>
                        <option>10:30 AM</option>
                        <option>11:00 AM</option>
                        <option>11:30 AM</option>
                        <option>12:00 PM</option>
                        <option>12:30 PM</option>
                        <option>01:00 PM</option>
                        <option>01:30 PM</option>
                        <option>02:00 PM</option>
                        <option>02:30 PM</option>
                        <option>03:00 PM</option>
                        <option>03:30 PM</option>
                        <option>04:00 PM</option>
                        <option>04:30 PM</option>
                        <option>05:00 PM</option>
                    </select>
                </div>
            </div>
        </fieldset>

        <div class="en-actions">
            <button type="submit" name="accion" value="GenerarPDF" class="btn btn-primary">📄 Generar PDF</button>
            <button type="submit" name="accion" value="EnviarWhatsapp" class="btn btn-success">📤 Enviar Matrícula por WhatsApp</button>
        </div>
    }
</main>
