@model WEB_LBA.Models.M_MatriculaMEP
@{
    ViewBag.Title = "Formulario de Matrícula";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="text-center mb-4">Formulario de Matrícula</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }

    @using (Html.BeginForm("EnviarMatricula", "Matricula", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="card p-4 mb-4 shadow">
            <h4 class="mb-3">Datos del Estudiante</h4>
            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.nombre_estudiante)
                    @Html.TextBoxFor(m => m.nombre_estudiante, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.nombre_estudiante, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.cedula_estudiante)
                    @Html.TextBoxFor(m => m.cedula_estudiante, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.cedula_estudiante, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.fecha_nacimiento)
                    @Html.TextBoxFor(m => m.fecha_nacimiento, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.fecha_nacimiento, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.genero)
                    @Html.TextBoxFor(m => m.genero, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.genero, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.nacionalidad_estudiante)
                    @Html.TextBoxFor(m => m.nacionalidad_estudiante, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.lugar_nacimiento)
                    @Html.TextBoxFor(m => m.lugar_nacimiento, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.tipo_agrupamiento)
                    @Html.TextBoxFor(m => m.tipo_agrupamiento, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.modalidad_ingreso)
                    @Html.TextBoxFor(m => m.modalidad_ingreso, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.escuela_procedencia)
                    @Html.TextBoxFor(m => m.escuela_procedencia, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.distrito_donde_vive)
                    @Html.TextBoxFor(m => m.distrito_donde_vive, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.pueblo_donde_vive)
                    @Html.TextBoxFor(m => m.pueblo_donde_vive, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.telefono_estudiante)
                    @Html.TextBoxFor(m => m.telefono_estudiante, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.correo_electronico_estudiante)
                    @Html.TextBoxFor(m => m.correo_electronico_estudiante, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.correo_electronico_estudiante, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.nivel_academico)
                    @Html.TextBoxFor(m => m.nivel_academico, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.grado_academico)
                    @Html.TextBoxFor(m => m.grado_academico, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(m => m.modalidad_academica)
                    @Html.TextBoxFor(m => m.modalidad_academica, new { @class = "form-control" })
                </div>
                <div class="col-md-6 form-check mt-2">
                    @Html.CheckBoxFor(m => m.recibe_ayuda_economica, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.recibe_ayuda_economica, new { @class = "form-check-label" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.tipo_ayuda)
                    @Html.TextBoxFor(m => m.tipo_ayuda, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="card p-4 mb-4 shadow">
            <h4 class="mb-3">Datos de la Madre</h4>
            <div class="row g-3">
                <div class="col-md-6">@Html.LabelFor(m => m.nombre_madre) @Html.TextBoxFor(m => m.nombre_madre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.cedula_madre) @Html.TextBoxFor(m => m.cedula_madre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.nacionalidad_madre) @Html.TextBoxFor(m => m.nacionalidad_madre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.telefono_madre) @Html.TextBoxFor(m => m.telefono_madre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.escolaridad_madre) @Html.TextBoxFor(m => m.escolaridad_madre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.direccion_madre) @Html.TextBoxFor(m => m.direccion_madre, new { @class = "form-control" })</div>
            </div>
        </div>

        <div class="card p-4 mb-4 shadow">
            <h4 class="mb-3">Datos del Padre</h4>
            <div class="row g-3">
                <div class="col-md-6">@Html.LabelFor(m => m.nombre_padre) @Html.TextBoxFor(m => m.nombre_padre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.cedula_padre) @Html.TextBoxFor(m => m.cedula_padre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.nacionalidad_padre) @Html.TextBoxFor(m => m.nacionalidad_padre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.telefono_padre) @Html.TextBoxFor(m => m.telefono_padre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.escolaridad_padre) @Html.TextBoxFor(m => m.escolaridad_padre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.direccion_padre) @Html.TextBoxFor(m => m.direccion_padre, new { @class = "form-control" })</div>
            </div>
        </div>

        <div class="card p-4 mb-4 shadow">
            <h4 class="mb-3">Permisos</h4>
            <div class="form-check">@Html.CheckBoxFor(m => m.permiso_educacion_religiosa, new { @class = "form-check-input" }) @Html.LabelFor(m => m.permiso_educacion_religiosa, new { @class = "form-check-label" })</div>
            <div class="form-check">@Html.CheckBoxFor(m => m.permiso_salidas_libres, new { @class = "form-check-input" }) @Html.LabelFor(m => m.permiso_salidas_libres, new { @class = "form-check-label" })</div>
            <div class="form-check">@Html.CheckBoxFor(m => m.permiso_imagenes, new { @class = "form-check-input" }) @Html.LabelFor(m => m.permiso_imagenes, new { @class = "form-check-label" })</div>
            <div class="form-check">@Html.CheckBoxFor(m => m.permiso_autoriza_otro_retirar, new { @class = "form-check-input" }) @Html.LabelFor(m => m.permiso_autoriza_otro_retirar, new { @class = "form-check-label" })</div>
        </div>

        <div class="card p-4 mb-4 shadow">
            <h4 class="mb-3">Firma y Comentarios</h4>
            <div class="row g-3">
                <div class="col-md-12">@Html.LabelFor(m => m.comentario_adicional) @Html.TextAreaFor(m => m.comentario_adicional, new { @class = "form-control", rows = 3 })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.firma_padre_madre) @Html.TextBoxFor(m => m.firma_padre_madre, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.cedula_firma) @Html.TextBoxFor(m => m.cedula_firma, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.nombre_funcionario) @Html.TextBoxFor(m => m.nombre_funcionario, new { @class = "form-control" })</div>
                <div class="col-md-6">@Html.LabelFor(m => m.fecha_firma) @Html.TextBoxFor(m => m.fecha_firma, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })</div>
            </div>
        </div>

        <div class="text-center mb-5 mt-4">
            <input type="submit" value="Enviar Matrícula" class="btn btn-success btn-lg" />
        </div>
    }
</div>