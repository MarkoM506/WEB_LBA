@model WEB_LBA.Models.M_AsistenciaReporte

@{
    ViewBag.Title = "Seleccionar período para consultar asistencia";
}

<h2>Seleccionar período</h2>

@using (Html.BeginForm("ReporteMensual", "Asistencia", FormMethod.Get))
{
    <div class="form-group">
        <label for="id_seccion">Sección:</label>
        @Html.DropDownListFor(m => m.id_seccion, new SelectList(ViewBag.Secciones, "id_seccion", "nombre_seccion"), "-- Seleccione una sección --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label for="id_profesor">Profesor:</label>
        @Html.DropDownListFor(m => m.id_profesor, new SelectList(ViewBag.Profesores, "id_profesor", "nombre"), "-- Seleccione un profesor --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label for="id_materia">Materia:</label>
        @Html.DropDownListFor(m => m.id_materia, new SelectList(ViewBag.Materias, "id_materia", "nombre_materia"), "-- Seleccione una materia --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label for="mes">Mes:</label>
        @Html.DropDownList("mes", new SelectList(
                 new[] {
                new { Value = 1, Text = "Enero" },
                new { Value = 2, Text = "Febrero" },
                new { Value = 3, Text = "Marzo" },
                new { Value = 4, Text = "Abril" },
                new { Value = 5, Text = "Mayo" },
                new { Value = 6, Text = "Junio" },
                new { Value = 7, Text = "Julio" },
                new { Value = 8, Text = "Agosto" },
                new { Value = 9, Text = "Setiembre" },
                new { Value = 10, Text = "Octubre" },
                new { Value = 11, Text = "Noviembre" },
                new { Value = 12, Text = "Diciembre" }
                         }, "Value", "Text"
             ), "-- Seleccione un mes --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label for="anio">Año:</label>
        @Html.TextBox("anio", DateTime.Now.Year, new { @class = "form-control", type = "number" })
    </div>

    <button type="submit" class="btn btn-primary">Consultar Asistencia</button>
}