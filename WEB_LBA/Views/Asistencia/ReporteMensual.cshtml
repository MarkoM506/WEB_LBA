@model WEB_LBA.Models.M_AsistenciaReporte

@{
    ViewBag.Title = "Reporte Mensual de Asistencia";
    var diasMes = Model.diasEnElMes;
}

<h2>Reporte Mensual de Asistencia</h2>

@using (Html.BeginForm("ReporteMensual", "Asistencia", FormMethod.Post))
{
    <div class="row mb-3">
        <div class="col-md-2">
            @Html.LabelFor(m => m.mes)
            @Html.DropDownListFor(m => m.mes, new SelectList(
                          Enumerable.Range(1, 12).Select(i => new SelectListItem
                          {
                              Value = i.ToString(),
                              Text = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                          }), "Value", "Text", Model.mes), "Seleccione", new { @class = "form-control" })
        </div>
        <div class="col-md-2">
            @Html.LabelFor(m => m.anio)
            @Html.TextBoxFor(m => m.anio, new { @class = "form-control", type = "number" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.id_profesor)
            @Html.DropDownListFor(m => m.id_profesor, (SelectList)ViewBag.Profesores, "Seleccione", new { @class = "form-control" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.id_seccion)
            @Html.DropDownListFor(m => m.id_seccion, (SelectList)ViewBag.Secciones, "Seleccione", new { @class = "form-control" })
        </div>
        <div class="col-md-2">
            @Html.LabelFor(m => m.id_materia)
            @Html.DropDownListFor(m => m.id_materia, (SelectList)ViewBag.Materias, "Seleccione", new { @class = "form-control" })
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Consultar</button>
}

@if (Model.resultado != null && Model.resultado.Any())
{
    <hr />
    <h4>Resultados</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    @for (int d = 1; d <= diasMes; d++)
                    {
                        <th style="text-align:center">@d</th>
                    }
                    <th style="text-align:center">✔</th>
                    <th style="text-align:center">❌</th>
                    <th style="text-align:center">J</th>
                    <th style="text-align:center">T</th>
                    <th style="text-align:center">%</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.resultado)
                {
                    <tr>
                        <td>@item.estudiante</td>
                        @for (int d = 1; d <= diasMes; d++)
                        {
                            string key = d.ToString("D2");
                            string simbolo = item.simbolos.ContainsKey(key) ? item.simbolos[key] : "";
                            string visual = simbolo == "A" ? "A" : simbolo;

                            <td style="text-align:center">@visual</td>
                        }
                        <td style="text-align:center">@item.total_presente</td>
                        <td style="text-align:center">@item.total_faltas</td>
                        <td style="text-align:center">@item.total_justificada</td>
                        <td style="text-align:center">@item.total_tardanza</td>
                        <td style="text-align:center">@item.porcentaje_asistencia %</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning mt-3">No se encontraron registros para los filtros seleccionados.</div>
}