@model List<Entidades.Estudiante>

@{
    ViewBag.Title = "Tomar Asistencia";

    int diasEnElMes = DateTime.DaysInMonth(ViewBag.AnioSeleccionado, ViewBag.MesSeleccionado);
    var asistencias = ViewBag.Asistencias as List<Entidades.Asistencia>;
}

<h2>Tomar Asistencia</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <strong>Profesor:</strong> @ViewBag.NombreProfesor &nbsp;&nbsp;
    <strong>Materia:</strong> @ViewBag.NombreMateria &nbsp;&nbsp;
    <strong>Mes:</strong> @ViewBag.MesSeleccionado &nbsp;&nbsp;
    <strong>Año:</strong> @ViewBag.AnioSeleccionado
</div>

@using (Html.BeginForm("GuardarAsistenciasMasivo", "Asistencia", FormMethod.Post))
{
    <input type="hidden" name="mes" value="@ViewBag.MesSeleccionado" />
    <input type="hidden" name="anio" value="@ViewBag.AnioSeleccionado" />
    <input type="hidden" name="id_seccion" value="@ViewBag.IdSeccion" />
    <input type="hidden" name="id_profesor" value="@ViewBag.IdProfesor" />
    <input type="hidden" name="id_materia" value="@ViewBag.IdMateria" />

    <div class="table-responsive" style="overflow-x:auto;">
        <table class="table table-bordered table-sm table-striped">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    @for (int dia = 1; dia <= diasEnElMes; dia++)
                    {
                        <th style="text-align:center">@dia</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var est in Model)
                {
                    <tr>
                        <td>@est.nombre</td>
                        @for (int dia = 1; dia <= diasEnElMes; dia++)
                        {
                            DateTime fecha = new DateTime(ViewBag.AnioSeleccionado, ViewBag.MesSeleccionado, dia);
                            var asistencia = asistencias?.FirstOrDefault(a =>
                                a.id_estudiante == est.id_estudiante &&
                                a.fecha.Value.Date == fecha.Date);

                            string simbolo = "";
                            if (asistencia != null)
                            {
                                switch (asistencia.id_estado)
                                {
                                    case 1: simbolo = "✔"; break;
                                    case 2: simbolo = "❌"; break;
                                    case 3: simbolo = "J"; break;
                                    case 4: simbolo = "T"; break;
                                    default: simbolo = ""; break;
                                }
                            }

                            <td style="min-width:50px; text-align:center">
                                <select name="asistencias[@est.id_estudiante][@dia]" class="form-control input-sm">
                                    <option value="">--</option>
                                    <option value="✔" @(simbolo == "✔" ? "selected" : "")>✔</option>
                                    <option value="❌" @(simbolo == "❌" ? "selected" : "")>❌</option>
                                    <option value="J" @(simbolo == "J" ? "selected" : "")>J</option>
                                    <option value="T" @(simbolo == "T" ? "selected" : "")>T</option>
                                </select>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-success mt-3">Guardar Asistencia</button>
}